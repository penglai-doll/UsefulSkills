.DS_Store
__pycache__/
*.pyc
android-malware-analysis/**/__pycache__/

# Keep this repository focused on skill bodies. Top-level working folders,
# generated reports, and local agent state should not be committed.
/.claude/
.claude/worktrees/
/.playwright-mcp/
/docs/
output*/

# Local malware samples must stay outside GitHub history.
*.apk
*.apks
*.xapk

# Tiny synthetic archives are versioned only as deterministic test fixtures.
!android-malware-analysis/tests/fixtures/archives/*.apk
!android-malware-analysis/tests/fixtures/archives/*.apks

# Local planning/spec scratch files should not be published.
/docs/superpowers/specs/
